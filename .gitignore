# Python
# Entorno virtual
.venv/
venv/

# Caché de Python
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Audio: ningún archivo de audio se sube al repositorio
*.wav
*.WAV
*.mp3
*.MP3
*.flac
*.ogg
*.m4a
*.aac
*.aiff
*.aif

# Carpeta de audios de trabajo: se conserva solo el .gitkeep
dsp/audio/*
!dsp/audio/.gitkeep

# Editores y sistema operativo
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Salidas generadas por el modelo DSP (gráficas, audios filtrados, tablas)
dsp/output/