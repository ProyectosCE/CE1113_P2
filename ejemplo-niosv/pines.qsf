# DE1-SoC: reloj, reset (KEY0, activo en bajo) y LEDR[7:0] para el SoC Nios V "hello"
set_location_assignment PIN_AF14 -to clk_clk
set_location_assignment PIN_AA14 -to reset_reset_n
set_location_assignment PIN_V16  -to leds_external_connection_export[0]
set_location_assignment PIN_W16  -to leds_external_connection_export[1]
set_location_assignment PIN_V17  -to leds_external_connection_export[2]
set_location_assignment PIN_V18  -to leds_external_connection_export[3]
set_location_assignment PIN_W17  -to leds_external_connection_export[4]
set_location_assignment PIN_W19  -to leds_external_connection_export[5]
set_location_assignment PIN_Y19  -to leds_external_connection_export[6]
set_location_assignment PIN_W20  -to leds_external_connection_export[7]

set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk_clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to reset_reset_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to leds_external_connection_export[*]
